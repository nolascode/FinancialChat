@page "/chat"
@{
    ViewData["Title"] = "Chat Rooms";
    Layout = "_Layout";
}

<div class="row">
    <div class="col-md-8">
        <h2>Chat Rooms</h2>
    </div>
    <div class="col-md-4 text-end">
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createRoomModal">
            Create Room
        </button>
    </div>
</div>

<div id="roomList" class="row mt-4">
    <div class="col-12 text-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
</div>

<!-- Create Room Modal -->
<div class="modal fade" id="createRoomModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create Chat Room</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="createErrorAlert" class="alert alert-danger" style="display:none;"></div>
                <form id="createRoomForm">
                    <div class="mb-3">
                        <label for="roomName" class="form-label">Room Name</label>
                        <input type="text" class="form-control" id="roomName" required>
                    </div>
                    <div class="mb-3">
                        <label for="roomDescription" class="form-label">Description (optional)</label>
                        <textarea class="form-control" id="roomDescription" rows="2"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="createRoom()">Create</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const token = localStorage.getItem('token');
        if (!token) {
            window.location.href = '/auth/login';
        }

        function handleUnauthorized(response) {
            if (response.status === 401) {
                localStorage.removeItem('token');
                window.location.href = '/auth/login';
                return true;
            }
            return false;
        }

        async function loadRooms() {
            try {
                const response = await fetch('/api/chatrooms', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });

                if (handleUnauthorized(response)) return;

                const result = await response.json();

                if (result.success) {
                    renderRooms(result.data);
                }
            } catch (error) {
                console.error('Error loading rooms:', error);
            }
        }

        function renderRooms(rooms) {
            const roomList = document.getElementById('roomList');

            if (rooms.length === 0) {
                roomList.innerHTML = `
                    <div class="col-12 text-center">
                        <p class="text-muted">No chat rooms yet. Create one to get started!</p>
                    </div>
                `;
                return;
            }

            roomList.innerHTML = rooms.map(room => `
                <div class="col-md-4 mb-3">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">${escapeHtml(room.name)}</h5>
                            <p class="card-text text-muted">${room.description ? escapeHtml(room.description) : 'No description'}</p>
                            <p class="card-text"><small class="text-muted">${room.messageCount} messages</small></p>
                        </div>
                        <div class="card-footer">
                            <a href="/chat/room?id=${room.id}" class="btn btn-primary btn-sm">Join</a>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        async function createRoom() {
            const name = document.getElementById('roomName').value;
            const description = document.getElementById('roomDescription').value;
            const errorAlert = document.getElementById('createErrorAlert');
            errorAlert.style.display = 'none';

            try {
                const response = await fetch('/api/chatrooms', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': 'Bearer ' + token
                    },
                    body: JSON.stringify({ name, description })
                });

                if (handleUnauthorized(response)) return;

                const result = await response.json();

                if (result.success) {
                    bootstrap.Modal.getInstance(document.getElementById('createRoomModal')).hide();
                    document.getElementById('createRoomForm').reset();
                    loadRooms();
                } else {
                    errorAlert.textContent = result.message || 'Failed to create room';
                    errorAlert.style.display = 'block';
                }
            } catch (error) {
                errorAlert.textContent = 'An error occurred. Please try again.';
                errorAlert.style.display = 'block';
            }
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        loadRooms();
    </script>
}
